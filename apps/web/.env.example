# Base URL of the API, including the version prefix.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Firebase project used for authentication.
# The API key was previously committed to this repository; it was removed from
# the history with git-filter-repo but is still live on the original GitHub
# remote. Rotate it, then supply the new value here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=parcel-management-app-100ca.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=parcel-management-app-100ca
VITE_FIREBASE_STORAGE_BUCKET=parcel-management-app-100ca.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Profile-photo uploads (My Profile) via imgbb. Get a key at https://api.imgbb.com.
# Without it, profile updates without a new picture still work; uploads fail.
VITE_IMAGE_HOSTING_KEY=
