# Base URL of the API, including the version prefix.
# The auth client derives the API origin from this (Better Auth lives at /api/auth).
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Profile photos upload through the API (Multer + Cloudinary at POST /uploads/image),
# so no image-hosting key is needed on the client.

# Stripe publishable key for the Payments page. Get it at https://dashboard.stripe.com/apikeys.
# Without it, the Payments page shows a setup notice instead of crashing.
# VITE_PAYMENT_GATEWAY_PK=pk_test_...
VITE_PAYMENT_GATEWAY_PK=
