# Port the API listens on.
PORT=5000

# MongoDB Atlas credentials. The cluster host is baked into
# src/config/env.js; supply only the credentials here.
DATABASE_LOCAL_USERNAME=
DATABASE_LOCAL_PASSWORD=

# Secret used to sign and verify JWT access tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=

# Stripe secret key used to create payment intents.
STRIPE_SECRET_KEY=
