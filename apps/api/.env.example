# Port the API listens on.
PORT=5000
NODE_ENV=development

# MongoDB — pick ONE style:
# 1) Full URI (recommended for Docker / Atlas / CI):
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.6egtgqe.mongodb.net/parcelManagementDB?retryWrites=true&w=majority
# 2) Legacy split credentials (cluster host is baked into src/config/env.js):
DATABASE_LOCAL_USERNAME=
DATABASE_LOCAL_PASSWORD=
# DATABASE_NAME=parcelManagementDB

# Better Auth (replaces the old hand-rolled JWT).
# Generate the secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
BETTER_AUTH_SECRET=
# Public origin of THIS api, used for auth callbacks and links.
BETTER_AUTH_URL=http://localhost:5000

# Google OAuth (optional — email/password always works). Create credentials at
# https://console.cloud.google.com/apis/credentials, then add the redirect URI
# <BETTER_AUTH_URL>/api/auth/callback/google to the authorized list.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Stripe secret key used to create payment intents.
STRIPE_SECRET_KEY=

# Comma-separated allowed browser origins for CORS (also Better Auth trusted origins).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Set TRUST_PROXY=1 behind Render / Fly / Nginx so rate-limit sees real IPs.
# TRUST_PROXY=
